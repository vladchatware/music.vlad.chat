FROM python:3.11-slim AS model-prep

ARG ESSENTIA_MODELS_ACCEPT_LICENSE=true
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl unzip \
  && rm -rf /var/lib/apt/lists/* \
  && pip install --no-cache-dir tensorflow==2.16.1 \
  && pip install --no-cache-dir --no-deps tensorflowjs==4.22.0 tf-keras==2.16.0 \
  && pip install --no-cache-dir packaging==23.2 \
  && mkdir -p /usr/local/lib/python3.11/site-packages/tensorflow_decision_forests \
      /usr/local/lib/python3.11/site-packages/tensorflow_hub \
  && touch /usr/local/lib/python3.11/site-packages/tensorflow_decision_forests/__init__.py \
      /usr/local/lib/python3.11/site-packages/tensorflow_hub/__init__.py \
  && sed -i '/jax_conversion import convert_jax/d' \
      /usr/local/lib/python3.11/site-packages/tensorflowjs/converters/__init__.py
COPY --from=oven/bun:1.3.8 /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /prepare
COPY workers/track-analysis/prepareModels.ts workers/track-analysis/modelCatalog.ts ./workers/track-analysis/
RUN mkdir -p /models \
  && if [ "$ESSENTIA_MODELS_ACCEPT_LICENSE" = "true" ]; then \
       ESSENTIA_MODEL_DIR=/models ESSENTIA_CONVERTER_BIN=/usr/local/bin/tensorflowjs_converter \
       bun run workers/track-analysis/prepareModels.ts --accept-noncommercial-license; \
     fi

FROM oven/bun:1.3.8

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

COPY workers ./workers
COPY lib ./lib
COPY soundcloud.ts ./soundcloud.ts
COPY tsconfig.json ./tsconfig.json
COPY --from=model-prep /models ./workers/track-analysis/models

ENV PORT=3001
EXPOSE 3001

CMD ["bun", "run", "workers/track-analysis/index.ts"]
