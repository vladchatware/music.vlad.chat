# Copy to workers/track-analysis/.env on worker machine.
ANALYSIS_SERVICE_SECRET=replace-with-the-same-secret-used-in-vercel
CONVEX_SITE_URL=https://your-deployment.convex.site
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_ACCESS_TOKEN=
SOUNDCLOUD_REFRESH_TOKEN=
SOUNDCLOUD_ACCESS_TOKEN_EXPIRES_AT=

ANALYSIS_WORKER_CONCURRENCY=2
ESSENTIA_MODELS_ACCEPT_LICENSE=true

# Vercel Queues poll-mode consumption (track-analysis topic, iad1 region).
# The worker mints short-lived Vercel OIDC tokens through the Vercel API:
# VERCEL_API_TOKEN needs the project access scope; VERCEL_PROJECT_ID /
# VERCEL_ORG_ID come from .vercel/repo.json (prj_... / team_...).
VERCEL_QUEUE_REGION=iad1
VERCEL_QUEUE_TOPIC=track-analysis
VERCEL_QUEUE_CONSUMER_GROUP=track-analysis-worker
VERCEL_QUEUE_POLL_INTERVAL_MS=2000
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
# Optional static OIDC token override for local testing (skips minting).
VERCEL_QUEUE_TOKEN=
# Set to false to disable the queue consumer loop.
ANALYSIS_QUEUE_CONSUMER_ENABLED=true

# Cloudflare Zero Trust > Networks > Tunnels > your tunnel > Docker token.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional observability.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1
