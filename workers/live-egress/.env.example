# Generate API key/secret; never reuse these example values in production.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters

# Local browser connects through ws://localhost:7880. For a public VM, set
# public IPv4 address advertised in ICE candidates and terminate WSS externally.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882

# Pinned known releases. Upgrade deliberately and validate together.
LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.1
LIVEKIT_EGRESS_IMAGE=livekit/egress:v1.12.0

EGRESS_HEALTH_PORT=8081
EGRESS_PROMETHEUS_PORT=9091
